# ===========================================
# Environment Configuration - Example
# ===========================================
# Copy this file to .env and configure values

# ===========================================
# Application
# ===========================================
APP_NAME=AI-Testing-Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===========================================
# API Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ===========================================
# Security
# ===========================================
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
API_KEY_HEADER=X-API-Key

# Fernet symmetric key for encrypting run credentials at rest.
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, a process-scoped fallback key is used (credentials lost on restart).
CREDENTIAL_ENCRYPTION_KEY=

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=540

# ===========================================
# LLM Provider Configuration
# ===========================================
LLM_PROVIDER=openai
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY=2
LLM_MAX_CONCURRENT=10

# ===========================================
# Storage Configuration
# ===========================================
STORAGE_TYPE=local
STORAGE_BASE_PATH=./storage
ARTIFACTS_PATH=./storage/artifacts
LOGS_PATH=./storage/logs
TEMP_PATH=./storage/temp

# ===========================================
# Artifact Configuration
# ===========================================
ARTIFACT_MAX_SIZE_MB=100
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_COMPRESSION=true

# ===========================================
# Playwright Configuration
# ===========================================
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_VIEWPORT_WIDTH=1920
PLAYWRIGHT_VIEWPORT_HEIGHT=1080

# ===========================================
# Logging Configuration
# ===========================================
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_ROTATION=10MB
LOG_FILE_RETENTION=30
LOG_CORRELATION_ENABLED=true

# ===========================================
# Monitoring & Telemetry
# ===========================================
TELEMETRY_ENABLED=false
METRICS_ENABLED=true
TRACING_ENABLED=false

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/testing_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=10

# ===========================================
# Redis (Future Use)
# ===========================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_MAX_CONNECTIONS=50

# ===========================================
# Contract Validation
# ===========================================
CONTRACT_VALIDATION_ENABLED=true
CONTRACT_SCHEMA_PATH=./contracts
CONTRACT_STRICT_MODE=true

# ===========================================
# Prompt Management
# ===========================================
PROMPT_BASE_PATH=./prompts
PROMPT_CACHE_ENABLED=true
PROMPT_VERSIONING_ENABLED=true
